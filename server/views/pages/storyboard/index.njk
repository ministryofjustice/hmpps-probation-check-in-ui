{% extends "./_layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block storyboardContent %}
<div class="govuk-grid-row">
    <h1 class="govuk-heading-xl">{{ t('public.storyboard.title') }}</h1>
    <h2 class="govuk-heading-l">{{ t('public.storyboard.heading') }}</h2>
    <p class="govuk-body">{{ t('public.storyboard.intro') }}</p>
</div>
<div class="govuk-grid-row">
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    <div class="govuk-grid-column-one-half govuk-!-static-padding-left-0">
        <h3 class="govuk-heading-m">{{ t('public.storyboard.step1.title') }}</h3>
        <p class="govuk-body">{{ t('public.storyboard.step1.body1') }}</p>
        <p class="govuk-body">{{ t('public.storyboard.step1.body2') }}</p>
        <p class="govuk-body"><a class="govuk-link govuk-link--no-visited-state" href="/guidance/before-your-probation-officer-signs-you-up" rel="noreferrer noopener" target="_blank">{{ t('public.storyboard.step1.link') }} (opens in new tab)</a></p>
    </div>
    <div class="govuk-grid-column-one-half govuk-!-static-padding-right-0">
      <img class="govuk-!-width-full" src="/assets/images/Step1.png" alt="{{ t('public.storyboard.step1.alt') }}" />
    </div>
</div>
<div class="govuk-grid-row">
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    <div class="govuk-grid-column-one-half govuk-!-static-padding-left-0">
        <h3 class="govuk-heading-m">{{ t('public.storyboard.step2.title') }}</h3>
        <p class="govuk-body">{{ t('public.storyboard.step2.body1') }}</p>
        <p class="govuk-body">{{ t('public.storyboard.step2.body2') }}</p>

        <p class="govuk-body"><a class="govuk-link govuk-link--no-visited-state" href="/guidance/signing-up-to-use-online-check-ins" rel="noreferrer noopener" target="_blank">{{ t('public.storyboard.step2.link') }} (opens in new tab).</a></p>
    </div>
    <div class="govuk-grid-column-one-half govuk-!-static-padding-right-0">
      <img class="govuk-!-width-full" src="/assets/images/Step2.png" alt="{{ t('public.storyboard.step2.alt') }}" />
    </div>
</div>
<div class="govuk-grid-row">
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    <div class="govuk-grid-column-one-half govuk-!-static-padding-left-0">
