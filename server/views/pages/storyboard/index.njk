{{ govukButton({
  html: '<img class="es-print-button__icon" src="/assets/images/icon-print.svg" alt="" width="18" height="18" /> Print this page',
  type: "button",
  classes: "govuk-button--secondary es-print-button",
  attributes: { "data-print-page": "" }
}) }}
</div>
