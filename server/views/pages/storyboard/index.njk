        <p class="govuk-body"><a class="govuk-link govuk-link--no-visited-state" href="/guidance/what-to-do-if-youre-struggling-or-something-goes-wrong" rel="noreferrer noopener" target="_blank">{{ t('public.storyboard.step6.link') }} (opens in new tab).</a></p>
    </div>
    <div class="govuk-grid-column-one-half govuk-!-static-padding-right-0">
