{% extends "../../partials/layout.njk" %}
{%- from "moj/components/header/macro.njk" import mojHeader -%}

{% block pageTitle %}
 {{ pageTitle }} - {{ t('common.serviceNamePractitioner') }}
{% endblock %}

{% block header %}
  <div class="es-guidance-print-header">
    <div class="es-guidance-print-header__organisation">
      <img src="/assets/images/HMPPS_Lesser_Arms_Stacked_Black.png" alt="HM Prison &amp; Probation Service" />
    </div>
    <p>Manage probation check ins</p>
  </div>
  {{
    mojHeader({
      organisationLabel: {
        text: "HMPPS",
        href: "/practitioner-guidance-one-page"
      },
      serviceLabel: {
        html: t('public.practitionerGuidance.headerServiceLabel'),
        href: "/practitioner-guidance-one-page"
      }
    })
  }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds es-print-page">
      <h1 class="govuk-heading-xl">Online check ins</h1>
      <h2 class="govuk-heading-l">{{ pageTitle }}</h2>
      {% block onePageContent %}{% endblock %}
    </div>
  </div>
{% endblock %}

{% block footer %}
  {{ super() }}
  {% include "partials/guidancePrintFooter.njk" %}
{% endblock %}
