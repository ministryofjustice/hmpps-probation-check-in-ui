{% from "govuk/components/button/macro.njk" import govukButton %}
{% extends "../../partials/layout.njk" %}

{% set title = t('submission.verificationUnavailable.title') %}
{% set pageTitle = title %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ title }}</h1>
      <p class="govuk-body">{{ t('submission.verificationUnavailable.intro') }}</p>

      <h2 class="govuk-heading-m">{{ t('submission.verificationUnavailable.help.heading') }}</h2>
      <p class="govuk-body">{{ t('submission.verificationUnavailable.help.intro') }}</p>

      {{
        govukButton({
          text: t('common.buttons.tryAgain'),
          href: "/" + submissionId + "/verify"
        })
      }}
    </div>
  </div>
{% endblock %}
